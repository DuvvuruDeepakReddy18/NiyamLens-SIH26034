        { "imageId": 2, "role": "ingredients", "benchmark": true, "expectedTokens": ["ingredients", "wheat", "flour", "yeast", "salt", "olive"] },
        { "imageId": 3, "role": "nutrition", "benchmark": true, "expectedTokens": ["nutrition", "energy", "protein", "carbohydrate", "sugar", "sodium"] },
        { "imageId": 4, "role": "fssai-license", "benchmark": false, "expectedTokens": ["fssai", "lic", "11522998000168"] }
      ]
    },
