{
  "name": "NiyamLens Open Food Facts India real-label pilot",
  "version": "2026-09-03.2",
  "purpose": "Reproducible OCR stress test on contributor photographs of real Indian-market packages. This is not a compliance ground-truth dataset.",
  "source": {
    "name": "Open Food Facts Images on AWS Open Data",
    "catalogUrl": "https://registry.opendata.aws/openfoodfacts-images/",
    "documentationUrl": "https://openfoodfacts.github.io/openfoodfacts-server/api/aws-images-dataset/",
    "imageLicense": "CC BY-SA",
    "databaseLicense": "ODbL 1.0"
  },
  "selectionPolicy": "Recent India records with readable declaration panels, plus one deliberately difficult curved-bottle stress case. Front-only marketing images are excluded from the scored cases.",
  "products": [
