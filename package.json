{
  "name": "niyamlens",
  "private": true,
  "version": "0.4.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env.local tools/dev-api.mjs",
    "backend:start": "supabase start",
    "backend:status": "supabase status",
    "workspace:setup": "node --env-file-if-exists=.env.local tools/setup-workspace.mjs",
    "field:pilot": "node tools/field-pilot.mjs",
    "field:download": "node tools/download-field-pilot.mjs",
    "field:smoke": "node tools/run-field-ocr-smoke.mjs",
    "field:browser": "node tools/run-browser-field-pilot.mjs",
    "field:time-score": "node tools/score-workflow-study.mjs",
    "pilot:hosted": "node tools/verify-hosted-permissions.mjs",
    "backup:verify": "node tools/verify-workspace-backup.mjs",
    "qa:backup": "node --test tests/workspace-backup.test.mjs",
    "qa:pilot": "node --test tests/pilot-permissions-recovery.test.mjs tests/hosted-permissions-probe.test.mjs tests/workspace-client.test.mjs",
    "qa:field-pilot": "node --test tests/field-pilot.test.mjs tests/download-field-pilot.test.mjs tests/field-ocr-smoke.test.mjs",
    "build": "node tools/validate-build-config.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "qa:ui": "node tools/qa-ui.mjs",
    "qa:functional": "node tools/qa-functional.mjs",
    "qa:ocr": "node tools/qa-ocr.mjs",
    "qa:ocr:connected": "node tools/qa-connected-ocr.mjs",
    "qa:pwa": "node tools/qa-pwa.mjs",
    "docs:pptx": "node tools/build-official-sih-ppt.cjs",
    "demo:record": "node tools/record-live-demo.mjs",
    "demo:voiceover": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/add-demo-voiceover.ps1",
    "dataset:real:fetch": "node tools/fetch-real-label-benchmark.mjs",
    "qa:ocr:real": "node tools/qa-ocr-real.mjs",
    "qa:ocr:real:deep": "cross-env NIYAMLENS_OCR_MODE=deep node tools/qa-ocr-real.mjs",
    "qa:ocr:google-baseline": "node tools/qa-google-vision-baseline.mjs"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "@supabase/supabase-js": "^2.115.0",
    "docx": "9.7.1",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.24.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "supabase": "^2.116.0",
    "vite": "^6.0.5"
  }
}
